# 主连接串：MySQL 8.0（把 your-password 换成你本地 MySQL 的密码；真实密码只留在 .env，不进仓库）
DATABASE_URL=mysql+pymysql://root:your-password@127.0.0.1:3306/elder_care?charset=utf8mb4

# 答辩断网时切这行（SQLite 备用，相对路径按 backend/ 目录解析）：
# DATABASE_URL=sqlite:///./elder_care.db

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

# 演示期可选访问口令：留空则完全放行（默认）。填上后，
# 只有 GET /api/records 与 GET/DELETE /api/memories 需要请求头 X-Demo-Token 一致，
# chat / game / greeting 不受影响。
DEMO_TOKEN=

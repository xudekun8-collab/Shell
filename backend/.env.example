# 主连接串：MySQL 8.0（把 your-password 换成你本地 MySQL 的密码；真实密码只留在 .env，不进仓库）
DATABASE_URL=mysql+pymysql://root:your-password@127.0.0.1:3306/elder_care?charset=utf8mb4

# 答辩断网时切这行（SQLite 备用，相对路径按 backend/ 目录解析）：
# DATABASE_URL=sqlite:///./elder_care.db

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

# 微信登录（小程序后台「开发管理」→「开发设置」里拿）：
# WX_APPID 是小程序 AppID（wx 开头），WX_SECRET 是 AppSecret。两个都填了才走 /api/auth/wx。
WX_APPID=
WX_SECRET=

# token 签名密钥：自己生成一串足够长的随机字符串（如 openssl rand -hex 32），
# 代码里没有默认弱密钥，不填则登录接口直接 500。
AUTH_SECRET=

# 演示后门：默认关闭。答辩现场可临时改 1，开启 /api/auth/demo；
# 正式环境必须保持 0，否则演示登录会签发演示用户 token。
DEMO_MODE=0
# 演示模式允许登录的账号，逗号分隔；默认只开放内置演示账号。
DEMO_USERS=demo_user_1

# 仅当后端只允许受控反向代理访问时设为 1，才会信任 X-Forwarded-For 的第一个地址。
# 直连部署保持 0，避免客户端伪造来源 IP 绕过限流。
TRUST_PROXY_HEADERS=0

# 腾讯云语音合成需单独开通；TENCENT_SECRET_ID/KEY 缺失时返回 503。
# TTS_PROVIDER=tencent 时使用 TTS_VOICE，其他已填 TTS_API_KEY 的未接入供应商返回 501。
TTS_API_KEY=
TTS_VOICE=101001
TTS_PROVIDER=tencent

# 腾讯云一句话识别（ASR）：到腾讯云控制台「访问管理 → API 密钥」拿 SecretId/SecretKey。
# SecretId 以 AKID 开头；SecretKey 不是 SecretId，不要把同一个值填进两行。
# 两个都留空时 /api/asr 返回 503「语音识别服务未配置」。
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_REGION=ap-shanghai

# 已废弃：当前没有任何路由使用 require_demo_token。
# 业务鉴权统一使用 Authorization: Bearer <token> 与 require_role。
DEMO_TOKEN=

# 主连接串：MySQL 8.0（把 your-password 换成你本地 MySQL 的密码；真实密码只留在 .env，不进仓库）
DATABASE_URL=mysql+pymysql://root:your-password@127.0.0.1:3306/elder_care?charset=utf8mb4

# 答辩断网时切这行（SQLite 备用，相对路径按 backend/ 目录解析）：
# DATABASE_URL=sqlite:///./elder_care.db

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

# 微信登录（小程序后台「开发管理」→「开发设置」里拿）：
# WX_APPID 是小程序 AppID（wx 开头），WX_SECRET 是 AppSecret。两个都填了才走 /api/auth/wx。
WX_APPID=
WX_SECRET=

# token 签名密钥：自己生成一串足够长的随机字符串（如 openssl rand -hex 32），
# 代码里没有默认弱密钥，不填则登录接口直接 500。
AUTH_SECRET=

# 演示后门：1 表示开启 /api/auth/demo 直接进 demo_user_1，答辩现场用；
# 0 表示关闭演示登录、旧版带 user_id 的接口返回 403。
DEMO_MODE=1

# 语音合成（TTS）：三个都留空时 /api/tts 返回 503「语音合成服务未配置」。
# 填了 TTS_API_KEY 才进入接入点；TTS_VOICE 是音色、TTS_PROVIDER 是服务商标识（如 azure/aliyun/tencent）。
TTS_API_KEY=
TTS_VOICE=
TTS_PROVIDER=

# 演示期可选访问口令：留空则完全放行（默认）。填上后，
# 只有 GET /api/records 与 GET/DELETE /api/memories 需要请求头 X-Demo-Token 一致，
# chat / game / greeting 不受影响。
DEMO_TOKEN=

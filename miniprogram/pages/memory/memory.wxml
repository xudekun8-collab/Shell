<view class="page">
  <view class="status" wx:if="{{loading}}">正在读…</view>

  <view class="status clickable" wx:if="{{load_error}}" bindtap="retry">没读到，点这里再试一次</view>

  <block wx:if="{{!loading && !load_error}}">
    <view class="group" wx:if="{{profile}}">
      <view class="group-title">您告诉我的</view>
      <view class="profile-card">
        <view class="line">喜欢：{{profile.interests_text}}</view>
        <view class="line">不想提：{{profile.taboos_text}}</view>
      </view>
    </view>

    <view class="group">
      <view class="group-title">我们聊过的事</view>
      <view class="empty" wx:if="{{events.length === 0}}">我们还没聊过什么呢</view>
      <view class="item" wx:for="{{eventsShown}}" wx:key="memory_id">
        <view class="item-body">
          <view class="content">{{item.content}}</view>
          <view class="meta">{{item.date_text}}</view>
        </view>
        <view class="delete" data-id="{{item.memory_id}}" bindtap="onDelete">删除</view>
      </view>
      <view class="more" wx:if="{{eventsRemainder > 0}}" bindtap="toggleEvents">{{eventsExpanded ? '收起' : '还有 ' + eventsRemainder + ' 条，点这里看全部'}}</view>
    </view>

    <view class="detail">
      <view class="detail-toggle" bindtap="toggleDetail">详细记忆（给您家里人看）<text class="toggle-mark">{{showDetail ? '收起' : '展开'}}</text></view>
      <view class="detail-body" wx:if="{{showDetail}}">
        <view class="group" wx:for="{{eventGroupsShown}}" wx:key="month_label" wx:for-item="grp">
          <view class="month-title">{{grp.month_label}}</view>
          <view class="item" wx:for="{{grp.items}}" wx:key="memory_id">
            <view class="item-body">
              <view class="content">{{item.content}}</view>
              <view class="meta">{{item.date_text}}</view>
            </view>
          </view>
        </view>
        <view class="empty" wx:if="{{events.length === 0}}">还没有</view>
        <view class="more" wx:if="{{detailRemainder > 0}}" bindtap="toggleDetailEvents">{{detailExpanded ? '收起' : '还有 ' + detailRemainder + ' 条，点这里看全部'}}</view>

        <view class="group">
          <view class="group-title">这几天的聊天摘要</view>
          <view class="empty" wx:if="{{sessions.length === 0}}">还没有</view>
          <view class="item" wx:for="{{sessions}}" wx:key="index">
            <view class="item-body">
              <view class="content">{{item.content}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="group">
      <view class="group-title">家属</view>
      <view class="family-btns">
        <view class="family-btn" bindtap="onInvite">生成邀请码</view>
        <view class="family-btn" bindtap="goFamily">家属查看</view>
      </view>
    </view>
  </block>
</view>

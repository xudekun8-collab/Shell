<view class="page">
  <view class="group" wx:if="{{profile}}">
    <view class="group-title">画像</view>
    <view class="profile-card">
      <view class="line">称呼：{{profile.nickname}}</view>
      <view class="line">兴趣：{{profile.interests_text}}</view>
      <view class="line">忌讳：{{profile.taboos_text}}</view>
    </view>
  </view>

  <view class="group">
    <view class="group-title">事件记忆</view>
    <view class="empty" wx:if="{{events.length === 0}}">还没有事件记忆</view>
    <view class="item" wx:for="{{events}}" wx:key="memory_id">
      <view class="item-body">
        <view class="content">{{item.content}}</view>
        <view class="meta">{{item.occurred_at}} · 重要度{{item.importance}}</view>
      </view>
      <view class="delete" data-id="{{item.memory_id}}" bindtap="onDelete">删除</view>
    </view>
  </view>

  <view class="group">
    <view class="group-title">会话摘要</view>
    <view class="empty" wx:if="{{sessions.length === 0}}">还没有会话摘要</view>
    <view class="item" wx:for="{{sessions}}" wx:key="thread_id">
      <view class="item-body">
        <view class="content">{{item.content || '（暂无摘要）'}}</view>
      </view>
    </view>
  </view>
</view>

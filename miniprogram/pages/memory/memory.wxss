.page {
  padding: 28rpx;
}

.group {
  margin-bottom: 32rpx;
}

.group-title {
  margin-bottom: 16rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: var(--c-primary);
}

.profile-card {
  padding: 24rpx;
  background-color: var(--c-surface);
  border-radius: var(--r-card);
}

.line {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  color: #333333;
}

.item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 24rpx;
  background-color: var(--c-surface);
  border-radius: var(--r-card);
}

.item-body {
  flex: 1;
}

.content {
  font-size: 34rpx;
  color: #333333;
  overflow-wrap: anywhere;
}

.meta {
  margin-top: 10rpx;
  font-size: 32rpx;
  color: var(--c-text-weak);
}

.delete {
  min-height: 88rpx;
  margin-left: 20rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--c-danger);
  background-color: #fdecea;
  border-radius: var(--r-card);
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: var(--c-text-weak);
}

.status {
  padding: 120rpx 0;
  text-align: center;
  font-size: 32rpx;
  color: var(--c-text-weak);
}

.clickable {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.month-title {
  margin: 16rpx 0 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--c-text-weak);
}

.more {
  min-height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  color: var(--c-text-weak);
  text-align: left;
}

.detail {
  margin-top: 8rpx;
}

.detail-toggle {
  padding: 24rpx;
  font-size: 34rpx;
  color: var(--c-primary);
  background-color: #eef1f6;
  border-radius: var(--r-card);
}

.toggle-mark {
  float: right;
  font-size: 32rpx;
  color: var(--c-text-weak);
}

.detail-body {
  margin-top: 16rpx;
}

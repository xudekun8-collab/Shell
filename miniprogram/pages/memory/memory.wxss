.page {
  padding-top: var(--sp-4);
  padding-bottom: 28rpx;
  box-sizing: border-box;
}

.page-head {
  margin-bottom: var(--sp-4);
}

.page-kicker {
  margin-bottom: var(--sp-1);
  font-size: var(--fs-note);
  font-weight: 600;
  color: var(--c-accent);
}

.page-note {
  margin-top: var(--sp-2);
  font-size: var(--fs-note);
  line-height: 1.6;
  color: var(--c-text-weak);
}

.group {
  margin-bottom: var(--sp-4);
}

.group-title {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--c-primary);
}

.group-title::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background-color: var(--c-line);
}

.line {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-2);
  margin-bottom: var(--sp-1);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--c-text);
}

.line-key {
  flex: none;
  min-width: 132rpx;
  color: var(--c-text-weak);
}

.line-value {
  flex: 1 1 auto;
  min-width: 0;
  overflow-wrap: break-word;
}

.line-empty {
  color: var(--c-text-weak);
}

.profile-card {
  border-left: 8rpx solid var(--c-accent);
}

/* 改成右上小胶囊：原来 width:100% 的浅蓝按钮看着像禁用 */
.profile-edit {
  width: auto;
  min-width: 200rpx;
  min-height: 88rpx;
  margin: var(--sp-2) 0 0 auto;
  padding: 0 var(--sp-3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: var(--fs-body);
  color: var(--c-primary);
  box-sizing: border-box;
}

.edit-arrow {
  font-size: var(--fs-title);
  color: var(--c-accent);
}

.profile-editor {
  margin-top: var(--sp-2);
  border-left: 8rpx solid var(--c-primary);
}

.field-label {
  margin: var(--sp-2) 0 var(--sp-1);
  font-size: var(--fs-note);
  font-weight: 600;
  color: var(--c-text-weak);
}

.field-label:first-child {
  margin-top: 0;
}

.field-input {
  height: 96rpx;
  padding: 0 var(--sp-3);
  font-size: var(--fs-body);
  color: var(--c-text);
  background-color: #f4eee6;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.profile-editor-actions {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

.editor-cancel,
.editor-save {
  flex: 1;
  min-width: 0;
}

.item {
  display: flex;
  align-items: center;
  margin-bottom: var(--sp-2);
}

.item-body {
  flex: 1;
}

.content {
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--c-text);
  overflow-wrap: anywhere;
}

.meta {
  margin-top: 10rpx;
  font-size: var(--fs-note);
  color: var(--c-text-weak);
}

.delete {
  margin-left: 20rpx;
  font-size: var(--fs-body);
  color: var(--c-danger);
  background-color: #fdecea;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: var(--c-text-weak);
}

.status {
  padding: 120rpx 0;
  text-align: center;
  font-size: var(--fs-note);
  color: var(--c-text-weak);
}

.status.clickable {
  margin: 120rpx 0;
  padding: 0 var(--sp-3);
}

.month-title {
  margin: 16rpx 0 12rpx;
  font-size: var(--fs-note);
  font-weight: bold;
  color: var(--c-text-weak);
}

.more {
  min-height: 96rpx;
  line-height: 96rpx;
  font-size: var(--fs-body);
  color: var(--c-primary);
  text-align: left;
}

.detail {
  margin-top: 8rpx;
}

.detail-toggle {
  width: 100%;
  justify-content: space-between;
  padding: 0 var(--sp-3);
  font-size: var(--fs-body);
  color: var(--c-primary);
  background-color: var(--c-brand-soft);
  border-color: transparent;
}

.toggle-mark {
  float: right;
  font-size: var(--fs-note);
  color: var(--c-text-weak);
}

.detail-body {
  margin-top: 16rpx;
}

.family-btns {
  display: flex;
}

.family-card {
  border-left: 8rpx solid var(--c-primary);
}

.family-btn {
  width: 100%;
}

.family-btn {
  flex: 1;
  margin-right: 16rpx;
  font-size: var(--fs-body);
}

.family-btn:last-child {
  margin-right: 0;
}

.family-note {
  margin-top: var(--sp-2);
  font-size: var(--fs-note);
  line-height: 1.6;
  color: var(--c-text-weak);
}

.voice-settings {
  margin-top: var(--sp-5);
}

.setting-row {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin-bottom: var(--sp-2);
  border-left: 6rpx solid var(--c-brand-soft);
}

.setting-copy {
  flex: 1;
  min-width: 0;
}

.setting-name {
  font-size: var(--fs-body);
  font-weight: 600;
}

.setting-note {
  margin-top: 4rpx;
  font-size: var(--fs-note);
  line-height: 1.5;
  color: var(--c-text-weak);
}

.setting-toggle {
  flex: none;
  min-width: 96rpx;
  min-height: 96rpx;
  padding: 0 var(--sp-3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  color: var(--c-text-weak);
  background-color: var(--c-soft);
  border: 2rpx solid var(--c-soft);
  border-radius: var(--r-pill);
}

.setting-toggle.active {
  color: #ffffff;
  background-color: var(--c-primary);
  border-color: var(--c-primary);
}

.speed-setting {
  margin-top: var(--sp-2);
  border-left: 6rpx solid var(--c-accent-soft);
}

.speed-options {
  display: flex;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

.speed-option {
  flex: 1;
  min-width: 96rpx;
  min-height: 96rpx;
  padding: 0 var(--sp-1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  color: var(--c-text-weak);
  background-color: var(--c-soft);
  border: 2rpx solid var(--c-soft);
  border-radius: var(--r-pill);
  box-sizing: border-box;
}

.speed-option.active {
  color: var(--c-primary);
  background-color: var(--c-surface);
  border-color: var(--c-accent);
  font-weight: 600;
}

.account-actions {
  margin-top: var(--sp-4);
  padding-bottom: var(--sp-4);
}

.account-btn {
  width: 100%;
  margin-top: var(--sp-2);
  font-size: var(--fs-body);
}

.account-danger {
  color: var(--c-danger);
}

<view class="page">
  <view wx:if="{{phase === 'loading'}}" class="center">
    <view class="tip">正在准备</view>
  </view>

  <view wx:if="{{phase === 'error'}}" class="center">
    <view class="tip">我这儿信号有点弱，咱们等会儿再说。</view>
    <button class="primary-btn" bindtap="retry">再试一次</button>
  </view>

  <view wx:if="{{phase === 'remember'}}" class="stage">
    <view class="topbar">
      <view class="progress">记住第 {{remember_index + 1}}/{{remember_total}}</view>
      <view class="giveup" bindtap="tooHard">太难了</view>
    </view>
    <view class="show-item">{{remember_text}}</view>
  </view>

  <view wx:if="{{phase === 'quiz'}}" class="stage">
    <view class="topbar">
      <view class="progress">第 {{quiz_index + 1}}/{{quiz_total}}</view>
      <view class="giveup" bindtap="tooHard">太难了</view>
    </view>
    <block wx:if="{{game_type === 'memory_box'}}">
      <view class="question">刚才有「{{quiz_target}}」吗</view>
      <view class="btn-col">
        <button class="big-btn" data-value="1" bindtap="answerMemory">有</button>
        <button class="big-btn" data-value="0" bindtap="answerMemory">没有</button>
      </view>
    </block>
    <block wx:if="{{game_type === 'category_sort'}}">
      <view class="question">「{{word}}」属于哪一类</view>
      <view class="btn-col">
        <button class="big-btn" wx:for="{{options}}" wx:key="*this" data-value="{{item}}" bindtap="answerCategory">{{item}}</button>
      </view>
    </block>
  </view>

  <view wx:if="{{phase === 'result'}}" class="stage">
    <view class="main-result">{{main_text}}</view>
    <view class="sub-result" wx:if="{{sub_text}}">{{sub_text}}</view>
    <view class="result-note">这只是练习记录，不是看病依据。</view>
    <view class="next-diff">下一局：{{next_difficulty_text}}</view>
    <button class="primary-btn" bindtap="retry">再玩一次</button>
    <button class="secondary-btn" bindtap="backToChat">回去聊天</button>
  </view>
</view>

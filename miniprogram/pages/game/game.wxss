.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.tip {
  font-size: 36rpx;
  color: #666666;
  margin-bottom: 32rpx;
}

.stage {
  display: flex;
  flex-direction: column;
  min-height: 80vh;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.progress {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--c-primary);
}

.giveup {
  font-size: 32rpx;
  color: var(--c-text-weak);
  padding: 8rpx 16rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.show-item {
  font-size: 64rpx;
  font-weight: bold;
  text-align: center;
  color: var(--c-primary);
  padding: 160rpx 0;
}

.question {
  font-size: 42rpx;
  font-weight: bold;
  text-align: center;
  color: #333333;
  margin: 60rpx 0;
}

.btn-col {
  display: flex;
  flex-direction: column;
}

.big-btn {
  width: 100%;
  height: 110rpx;
  line-height: 110rpx;
  font-size: 36rpx;
  margin-bottom: 24rpx;
  border-radius: var(--r-btn);
  background-color: var(--c-primary);
  color: #ffffff;
}

.big-btn::after {
  border: none;
}

.main-result {
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  color: var(--c-primary);
  margin: 40rpx 0 24rpx;
}

.sub-result {
  font-size: 34rpx;
  color: #333333;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.result-note {
  font-size: 32rpx;
  color: var(--c-text-weak);
  text-align: center;
  margin-top: 8rpx;
}

.next-diff {
  font-size: 34rpx;
  color: var(--c-text-weak);
  text-align: center;
  margin: 24rpx 0 40rpx;
}

.primary-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 36rpx;
  background-color: var(--c-primary);
  color: #ffffff;
  border-radius: var(--r-btn);
}

.primary-btn::after {
  border: none;
}

.secondary-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 36rpx;
  margin-top: 24rpx;
  background-color: #eef1f6;
  color: var(--c-primary);
  border-radius: var(--r-btn);
}

.secondary-btn::after {
  border: none;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--c-bg);
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 16rpx;
}

.nickname {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--c-primary);
}

.capsules {
  display: flex;
  align-items: center;
}

.capsule {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  margin-left: 16rpx;
  font-size: 32rpx;
  color: var(--c-text);
  background-color: var(--c-soft);
  border-radius: 30rpx;
}

.accent-line {
  height: 4rpx;
  margin: 0 28rpx 8rpx;
  background-color: var(--c-accent);
}

.notice {
  display: flex;
  flex-direction: column;
  margin: 8rpx 28rpx 0;
  padding: 24rpx 28rpx;
  background-color: var(--c-surface);
  border-radius: var(--r-card);
  box-shadow: 0 4rpx 16rpx rgba(31, 58, 95, 0.06);
}

.notice-line {
  font-size: 32rpx;
  color: var(--c-text-weak);
  line-height: 1.7;
}

.notice-btn {
  align-self: flex-end;
  min-height: 88rpx;
  margin-top: 16rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--c-primary);
  background-color: var(--c-soft);
  border-radius: 32rpx;
}

.messages {
  flex: 1;
  min-height: 0;
  padding: 16rpx 28rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-row.assistant {
  justify-content: flex-start;
}

.msg-row.user {
  justify-content: flex-end;
}

.msg-row.system {
  justify-content: center;
}

.msg-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.user .msg-col {
  align-items: flex-end;
}

.bubble {
  padding: 28rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 58, 95, 0.06);
  overflow-wrap: anywhere;
  font-size: 34rpx;
  line-height: 1.7;
}

.bubble.pending {
  opacity: 0.55;
}

.assistant .bubble {
  max-width: 78%;
  background-color: var(--c-surface);
  color: var(--c-text);
}

.user .bubble {
  max-width: 72%;
  background-color: var(--c-primary);
  color: #ffffff;
}

.system-tip {
  font-size: 32rpx;
  color: var(--c-text-weak);
  background-color: rgba(31, 58, 95, 0.06);
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
}

.retry-hint {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: var(--c-primary);
  background: var(--c-soft);
  border-radius: var(--r-btn);
  margin-top: 12rpx;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--c-bg);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(31, 58, 95, 0.06);
  z-index: 10;
}

.wall {
  padding: 12rpx 28rpx 0;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.quick-phrase {
  width: 48%;
  height: 96rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 32rpx;
  color: var(--c-text);
  background-color: var(--c-surface);
  border-radius: var(--r-card);
  box-shadow: 0 4rpx 16rpx rgba(31, 58, 95, 0.06);
  box-sizing: border-box;
}

.wall-toggle {
  margin-top: 16rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 32rpx;
  color: var(--c-text-weak);
}

.wall-scroll {
  max-height: 52vh;
}

.phrase-group-title {
  margin: 8rpx 4rpx;
  font-size: 32rpx;
  color: var(--c-text-weak);
  text-align: left;
}

.phrase-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.phrase-btn {
  width: 48%;
  height: 96rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 32rpx;
  color: var(--c-text);
  background-color: var(--c-surface);
  border-radius: var(--r-card);
  box-shadow: 0 4rpx 16rpx rgba(31, 58, 95, 0.06);
  box-sizing: border-box;
}

.quick-row {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  padding: 8rpx 28rpx 0;
}

.quick-btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  margin: 0 8rpx 12rpx;
  font-size: 32rpx;
  color: var(--c-text);
  background-color: var(--c-soft);
  border-radius: 32rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx 0;
}

.voice-btn {
  min-height: 88rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--c-text);
  background-color: var(--c-soft);
  border-radius: var(--r-btn);
  flex-shrink: 0;
}

.voice-btn.recording {
  color: #ffffff;
  background-color: var(--c-primary);
}

.input {
  flex: 1;
  height: 88rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  color: var(--c-text);
  background-color: var(--c-surface);
  border-radius: var(--r-btn);
}

.input-placeholder {
  font-size: 32rpx;
  color: var(--c-text-weak);
}

.send-btn {
  width: 140rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-left: 16rpx;
  text-align: center;
  font-size: 32rpx;
  color: #ffffff;
  background-color: var(--c-primary);
  border-radius: var(--r-btn);
}

.send-btn.restart {
  width: 200rpx;
}

.disabled {
  opacity: 0.5;
}

.hover {
  background-color: #f3eee6;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background-color: #1f3a5f;
  color: #ffffff;
}

.greeting {
  font-size: 38rpx;
  font-weight: bold;
}

.links {
  display: flex;
}

.link {
  margin-left: 28rpx;
  font-size: 32rpx;
  color: #e8eef7;
}

.messages {
  flex: 1;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-row.assistant {
  justify-content: flex-start;
}

.msg-row.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  word-break: break-all;
}

.assistant .bubble {
  background-color: #ffffff;
  color: #333333;
  font-size: 36rpx;
  line-height: 1.6;
}

.user .bubble {
  background-color: #1f3a5f;
  color: #ffffff;
}

.quick {
  display: flex;
  padding: 12rpx 20rpx;
}

.quick-btn {
  flex: 1;
  margin: 0 8rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 32rpx;
  color: #1f3a5f;
  background-color: #eef1f6;
  border-radius: 12rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: #ffffff;
}

.voice-btn {
  width: 130rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  color: #c0c0c0;
  background-color: #f0f0f0;
  border-radius: 12rpx;
}

.input {
  flex: 1;
  height: 96rpx;
  margin: 0 16rpx;
  padding: 0 20rpx;
  font-size: 34rpx;
  background-color: #f5f6f8;
  border-radius: 12rpx;
}

.send-btn {
  width: 150rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 34rpx;
  color: #ffffff;
  background-color: #1f3a5f;
  border-radius: 12rpx;
}

.send-btn.disabled {
  opacity: 0.5;
}

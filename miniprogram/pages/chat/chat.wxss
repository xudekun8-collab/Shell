.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background-color: var(--c-bg);
}

.hero {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-4) var(--sp-2);
}

.hero-mark {
  flex: none;
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--c-surface-strong);
  background-color: var(--c-primary);
  border-radius: 24rpx 24rpx 24rpx 8rpx;
}

.hero-copy {
  min-width: 0;
}

.nickname {
  font-size: var(--fs-hero);
  font-weight: 700;
  line-height: 1.3;
  color: var(--c-primary);
}

.hero-note {
  margin-top: 2rpx;
  font-size: var(--fs-note);
  color: var(--c-text-weak);
}

.logout-link {
  flex: none;
  min-width: 96rpx;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-note);
  color: var(--c-text-weak);
}

.action-row {
  display: flex;
  gap: 12rpx;
  padding: 0 var(--sp-4) var(--sp-2);
}

.family-note-prompt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin: 0 var(--sp-4) var(--sp-2);
  background-color: var(--c-accent-soft);
  border-color: rgba(169, 85, 44, 0.24);
}

.family-note-copy {
  min-width: 0;
}

.family-note-label {
  font-size: var(--fs-note);
  font-weight: 600;
  color: var(--c-accent);
}

.family-note-title {
  margin-top: 2rpx;
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.4;
  color: var(--c-primary);
}

.family-note-open {
  flex: none;
  min-height: 72rpx;
  padding: 0 var(--sp-2);
  display: flex;
  align-items: center;
  color: var(--c-accent);
  font-size: var(--fs-note);
  font-weight: 600;
}

.note-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2000;
  padding: var(--sp-4);
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(28, 28, 28, 0.55);
  box-sizing: border-box;
}

.note-dialog {
  width: 100%;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
}

.note-dialog-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-primary);
}

.note-scroll {
  max-height: 48vh;
  margin-top: var(--sp-3);
}

.note-dialog-text {
  padding: var(--sp-2) 0;
  font-size: var(--fs-hero);
  line-height: 1.75;
  overflow-wrap: anywhere;
  color: var(--c-text);
}

.note-close {
  width: 100%;
  margin-top: var(--sp-3);
}

.action-btn {
  flex: 1;
  min-width: 96rpx;
  min-height: 96rpx;
  padding: 0 var(--sp-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  color: var(--c-primary);
  background-color: var(--c-surface);
  border: 1rpx solid var(--c-soft);
  border-radius: var(--r-md);
}

.action-btn-subtle {
  color: var(--c-text-weak);
  background-color: transparent;
}

.accent-line {
  height: 1rpx;
  margin: 0 var(--sp-4) var(--sp-2);
  background-color: var(--c-line);
}

.notice {
  display: flex;
  flex-direction: column;
  margin: var(--sp-1) var(--sp-4) 0;
  background-color: var(--c-brand-soft);
  border-color: #d5e0e9;
}

.notice-line {
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--c-text-weak);
}

.notice-btn {
  align-self: flex-end;
  min-height: 96rpx;
  margin-top: var(--sp-2);
}

.messages {
  flex: 1;
  min-height: 0;
  padding: var(--sp-3) var(--sp-4);
  box-sizing: border-box;
}

.welcome-card {
  margin-bottom: var(--sp-4);
  background-color: var(--c-surface);
  border-left: 8rpx solid var(--c-accent);
}

.welcome-title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--c-primary);
}

.welcome-copy {
  margin-top: var(--sp-1);
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--c-text-weak);
}

.msg-row {
  display: flex;
  margin-bottom: var(--sp-3);
}

.msg-row.assistant {
  justify-content: flex-start;
}

.msg-row.user {
  justify-content: flex-end;
}

.msg-row.system {
  justify-content: center;
}

.msg-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.user .msg-col {
  align-items: flex-end;
}

.bubble {
  max-width: 80%;
  padding: var(--sp-3) var(--sp-4);
  overflow-wrap: anywhere;
  font-size: var(--fs-body);
  line-height: 1.8;
  border-radius: 24rpx;
  box-shadow: none;
}

.bubble.pending {
  opacity: 0.55;
}

.bubble-hover {
  opacity: 0.82;
}

.assistant .bubble {
  color: var(--c-text);
  background-color: var(--c-surface);
  border: 1rpx solid var(--c-line);
  border-bottom-left-radius: 8rpx;
}

.user .bubble {
  color: var(--c-surface-strong);
  background-color: var(--c-primary);
  border-bottom-right-radius: 8rpx;
}

.system-tip {
  padding: 12rpx 28rpx;
  font-size: var(--fs-body);
  color: var(--c-text-weak);
  background-color: var(--c-soft);
  border-radius: var(--r-pill);
}

.retry-hint {
  min-width: 96rpx;
  min-height: 88rpx;
  margin-top: 12rpx;
}

.msg-hint {
  margin-top: 10rpx;
  padding-left: 8rpx;
  font-size: var(--fs-note);
  line-height: 1.4;
  color: var(--c-text-weak);
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  z-index: 10;
  padding-top: var(--sp-1);
  background-color: var(--c-surface);
  padding-bottom: 16rpx;
  border-top: 1rpx solid var(--c-line);
  box-shadow: 0 -8rpx 24rpx rgba(31, 58, 95, 0.08);
}

.wall {
  padding: 0;
}

/* 展开态：顶部常驻标题与收起，下面三种「常用回答」，再下面是可滚动的分组卡片 */
.wall-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx var(--sp-4) 0;
}

.wall-title {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--c-text);
}

.wall-close {
  min-width: 160rpx;
  min-height: 88rpx;
  padding: 0 var(--sp-3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: var(--fs-body);
  color: var(--c-primary);
  background-color: var(--c-brand-soft);
  border-radius: var(--r-pill);
  box-sizing: border-box;
}

.close-mark {
  font-size: var(--fs-title);
  line-height: 1;
}

.quick-bar {
  display: flex;
  gap: 12rpx;
  padding: 4rpx var(--sp-4) 12rpx;
  box-sizing: border-box;
}

/* 这三句是「动作」不是「话题」，用暖色与话题区分开 */
.quick-pill {
  flex: 1 1 0;
  min-height: 96rpx;
  padding: 8rpx var(--sp-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-accent);
  background-color: var(--c-accent-soft);
  border-radius: var(--r-pill);
  box-sizing: border-box;
}

.wall-scroll {
  max-height: 36vh;
  padding: 0 var(--sp-4) 8rpx;
  box-sizing: border-box;
}

.phrase-group {
  margin-bottom: 16rpx;
  padding: 4rpx 16rpx 20rpx;
  background-color: var(--c-surface-strong);
  border: 1rpx solid var(--c-line);
  border-radius: var(--r-lg);
  box-sizing: border-box;
}

.group-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 4rpx 14rpx;
}

.group-mark {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background-color: var(--c-accent);
}

.group-title {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--c-text);
}

.group-count {
  margin-left: auto;
  font-size: var(--fs-note);
  color: var(--c-text-weak);
}

/* 两列等宽：长短句都占半行，避免每行长短不齐的锯齿感 */
.group-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.group-grid .phrase-chip {
  flex: 1 1 calc(50% - 6rpx);
  min-width: 0;
  min-height: 96rpx;
  padding: 12rpx var(--sp-2);
  justify-content: center;
  text-align: center;
  line-height: 1.35;
}

/* 折叠态：一行横向滑动，动作在前、话题在后 */
.wall-collapsed {
  padding: 0;
}

.quick-scroll {
  width: 100%;
  padding: 0 var(--sp-4);
  box-sizing: border-box;
  white-space: nowrap;
}

.quick-grid {
  display: inline-flex;
  gap: 12rpx;
  min-width: 100%;
  padding-bottom: 4rpx;
  box-sizing: border-box;
}

.phrase-chip {
  flex: 0 0 auto;
  min-width: 96rpx;
  min-height: 96rpx;
  padding: 0 var(--sp-3);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  font-size: var(--fs-body);
  color: var(--c-text);
  background-color: var(--c-brand-soft);
  border: 0;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.quick-card {
  flex: 0 0 auto;
  min-width: auto;
  min-height: 96rpx;
  padding: 0 var(--sp-3);
  white-space: nowrap;
}

.quick-card.action {
  color: var(--c-accent);
  background-color: var(--c-accent-soft);
  font-weight: 600;
}

.wall-toggle {
  min-width: 96rpx;
  height: 88rpx;
  min-height: 88rpx;
  padding: var(--sp-1) var(--sp-4) 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  font-size: var(--fs-body);
  color: var(--c-text-weak);
  background-color: transparent;
  box-sizing: border-box;
}

.toggle-arrow {
  font-size: var(--fs-title);
  color: var(--c-accent);
}

.voice-preview {
  margin: 0 var(--sp-4) var(--sp-2);
  padding: var(--sp-3);
  color: var(--c-text);
  background-color: var(--c-accent-soft);
  border: 1rpx solid rgba(169, 85, 44, 0.35);
  border-left-width: 8rpx;
  border-radius: var(--r-md);
}

.voice-preview-text {
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.voice-preview-hint {
  margin-top: var(--sp-1);
  font-size: var(--fs-note);
  color: var(--c-text-weak);
}

.voice-preview-note {
  margin-top: 4rpx;
  font-size: var(--fs-note);
  line-height: 1.5;
  color: var(--c-accent);
}

.input-bar {
  height: 96rpx;
  padding: 0 var(--sp-4);
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.voice-state-bar {
  min-height: 96rpx;
  margin: 0 var(--sp-4) var(--sp-2);
  padding: 0 var(--sp-3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-surface-strong);
  background-color: var(--c-primary);
  border-radius: var(--r-pill);
  box-sizing: border-box;
}

.voice-state-bar.translating {
  color: var(--c-primary);
  background-color: var(--c-brand-soft);
}

.voice-state-dot {
  width: 16rpx;
  height: 16rpx;
  flex: none;
  background-color: currentColor;
  border-radius: 50%;
}

.voice-state-text {
  white-space: nowrap;
}

.input-bar .btn-main,
.input-bar .btn-ghost {
  height: 96rpx;
  min-height: 96rpx;
}

.voice-btn {
  width: 240rpx;
  padding: 0 var(--sp-2);
  flex-shrink: 0;
  font-size: var(--fs-body);
  line-height: 1.25;
  text-align: center;
  white-space: normal;
  background-color: var(--c-accent-soft);
}

.voice-btn.recording {
  color: #ffffff;
  background-color: var(--c-primary);
}

.voice-btn.disabled {
  opacity: 0.6;
}

.input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  padding: 0 var(--sp-3);
  font-size: var(--fs-body);
  color: var(--c-text);
  background-color: #f4eee6;
  border: 0;
  border-radius: var(--r-pill);
  box-sizing: border-box;
}

.input-placeholder {
  font-size: var(--fs-body);
  color: var(--c-text-weak);
}

.send-btn {
  min-width: 120rpx;
  padding: 0 var(--sp-2);
  flex-shrink: 0;
  font-size: var(--fs-title);
}

.send-btn.restart {
  min-width: 200rpx;
  flex-shrink: 0;
}

.disabled {
  opacity: 0.5;
}

.hover {
  background-color: var(--c-accent-soft);
}

<view class="page">
  <view class="hero">
    <view class="hero-mark">伴</view>
    <view class="hero-copy">
      <view class="nickname">{{greeting}}</view>
      <view class="hero-note">我在这儿，今天想聊点什么</view>
    </view>
  </view>
  <view class="family-note-prompt card" wx:if="{{familyNote}}" hover-class="press" bindtap="openFamilyNote">
    <view class="family-note-copy">
      <view class="family-note-label">家里人的话</view>
      <view class="family-note-title">家里人给您留了句话</view>
    </view>
    <view class="family-note-open">点开</view>
  </view>
  <view class="accent-line"></view>

  <view class="notice card" wx:if="{{showNotice}}">
    <view class="notice-line">这是一个陪您说话的练习帮手</view>
    <view class="notice-line">聊天文字会发给对话模型生成回复；语音交给云服务转文字，录音不保存</view>
    <view class="notice-line">它不是医生，身体不舒服还是要找大夫</view>
    <view class="btn-ghost notice-btn" hover-class="press" bindtap="dismissNotice">知道了</view>
  </view>

  <scroll-view class="messages" style="padding-bottom: {{dockHeight}}px" scroll-y scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view class="welcome-card card" wx:if="{{messages.length === 0}}">
      <view class="welcome-title">我在呢</view>
      <view class="welcome-copy">您可以直接说，也可以点下面的常用话。</view>
    </view>
    <view class="msg-row {{item.role}}" wx:for="{{messages}}" wx:key="uid" id="msg-{{index}}">
      <block wx:if="{{item.system || item.role === 'system'}}">
        <view class="system-tip">{{item.content}}</view>
      </block>
      <block wx:else>
        <view class="msg-col">
          <view class="bubble {{item.pending ? 'pending' : ''}}" data-text="{{item.content}}" data-pending="{{item.pending}}" bindtap="onSpeak" hover-class="bubble-hover">{{item.content}}</view>
          <view class="msg-hint" wx:if="{{item.role === 'assistant' && !item.pending && !item.failed && index === messages.length - 1}}">点一下这行字，我念给您听</view>
          <view class="btn-ghost retry-hint" wx:if="{{item.failed}}" hover-class="press" data-uid="{{item.uid}}" bindtap="retry">没发出去，点这里重试</view>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="dock">
    <view class="wall">
      <block wx:if="{{wallExpanded}}">
        <view class="wall-head">
          <view class="wall-title">常说的话</view>
          <view class="wall-close" hover-class="press" bindtap="toggleWall">
            <text>收起</text>
            <text class="close-mark">⌄</text>
          </view>
        </view>

        <view class="quick-bar">
          <view class="quick-pill {{ended ? 'disabled' : ''}}" hover-class="hover" wx:for="{{quickTexts}}" wx:key="label" data-text="{{item.text}}" bindtap="onQuick">{{item.label}}</view>
        </view>

        <scroll-view class="wall-scroll" scroll-y>
          <view class="phrase-group" wx:for="{{phraseGroups}}" wx:key="title" wx:for-item="group">
            <view class="group-head">
              <view class="group-mark"></view>
              <view class="group-title">{{group.title}}</view>
              <view class="group-count">{{group.items.length}} 句</view>
            </view>
            <view class="group-grid">
              <view class="phrase-chip {{ended ? 'disabled' : ''}}" hover-class="hover" wx:for="{{group.items}}" wx:key="*this" data-text="{{item}}" bindtap="onPhrase">{{item}}</view>
            </view>
          </view>
        </scroll-view>
      </block>

      <block wx:else>
        <view class="wall-collapsed">
          <scroll-view class="quick-scroll" scroll-x>
            <view class="quick-grid">
              <view class="phrase-chip quick-card action {{ended ? 'disabled' : ''}}" hover-class="hover" wx:for="{{quickTexts}}" wx:key="label" data-text="{{item.text}}" bindtap="onQuick">{{item.label}}</view>
              <view class="phrase-chip quick-card {{ended ? 'disabled' : ''}}" hover-class="hover" wx:for="{{quickPhrases}}" wx:key="*this" data-text="{{item}}" bindtap="onPhrase">{{item}}</view>
            </view>
          </scroll-view>
          <view class="wall-toggle" hover-class="press" bindtap="toggleWall">
            <text>还有别的说法</text>
            <text class="toggle-arrow">›</text>
          </view>
        </view>
      </block>
    </view>

    <view class="voice-preview" wx:if="{{pendingText}}" hover-class="press" bindtap="editPending">
      <view class="voice-preview-text">我听到的是：{{pendingText}}</view>
      <view class="voice-preview-hint">{{pendingCountdown}} 秒后发出去（点这里改一下）</view>
      <view class="voice-preview-note" wx:if="{{input}}">刚才那句在下面框里，您还想发就按发送</view>
    </view>

    <view class="voice-state-bar {{recording ? 'recording' : 'translating'}}" wx:if="{{recording || translating}}" hover-class="press" bindtap="onVoiceTap">
      <view class="voice-state-dot"></view>
      <view class="voice-state-text">{{recording ? '正在听…再点一下结束' : '正在听清您说的话…'}}</view>
    </view>

    <view class="input-bar" wx:else>
      <view class="btn-ghost voice-btn {{recording ? 'recording' : ''}} {{translating ? 'disabled' : ''}}" hover-class="press" aria-role="button" aria-label="点一下开始说话" bindtap="onVoiceTap">{{voiceLabel}}</view>
      <input class="input" placeholder-class="input-placeholder" value="{{input}}" maxlength="60" disabled="{{ended}}" bindinput="onInput" confirm-type="send" bindconfirm="onSend" placeholder="想说点什么" />
      <view class="btn-main send-btn" wx:if="{{!ended}}" hover-class="press" aria-role="button" aria-label="发送" bindtap="onSend">{{sending ? '发送中' : '发送'}}</view>
      <view class="btn-main send-btn restart" wx:else hover-class="press" bindtap="restart">重新开始</view>
    </view>
  </view>

  <view class="note-mask" wx:if="{{noteOpen && familyNote}}">
    <view class="note-dialog card">
      <view class="note-dialog-title">家里人给您留了句话</view>
      <scroll-view class="note-scroll" scroll-y>
        <view class="note-dialog-text">{{familyNote.text}}</view>
      </scroll-view>
      <view class="note-close btn-main" bindtap="closeFamilyNote">看完了</view>
    </view>
  </view>
</view>

<view class="page">
  <view class="header">
    <view class="greeting">{{greeting}}</view>
    <view class="links">
      <view class="link" bindtap="goMemory">记忆</view>
      <view class="link" bindtap="goGame">游戏</view>
    </view>
  </view>

  <scroll-view class="messages" scroll-y scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view class="msg-row {{item.role}}" wx:for="{{messages}}" wx:key="index" id="msg-{{index}}">
      <view class="bubble">{{item.content}}</view>
    </view>
  </scroll-view>

  <view class="quick">
    <view class="quick-btn" wx:for="{{quickTexts}}" wx:key="label" data-text="{{item.text}}" bindtap="onQuick">{{item.label}}</view>
  </view>

  <view class="input-bar">
    <view class="voice-btn" bindtap="onVoice">语音</view>
    <input class="input" value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="onSend" placeholder="想说点什么" />
    <view class="send-btn {{sending ? 'disabled' : ''}}" bindtap="onSend">{{sending ? '发送中' : '发送'}}</view>
  </view>
</view>

<view class="page">
  <view class="status" wx:if="{{loading}}">正在读…</view>

  <view class="status clickable" wx:if="{{load_error}}" bindtap="retry">没读到，点这里再试一次</view>

  <block wx:if="{{!loading && !load_error}}">
    <view class="summary" wx:if="{{summary.total > 0}}">
      <view class="summary-row">
        <view class="sum-item">
          <view class="num">{{summary.total}}</view>
          <view class="label">总次数</view>
        </view>
        <view class="sum-item">
          <view class="num">{{summary.avg_accuracy}}%</view>
          <view class="label">平均正确率</view>
        </view>
        <view class="sum-item">
          <view class="num">{{summary.total_duration_text}}</view>
          <view class="label">总用时</view>
        </view>
      </view>
      <view class="by-type" wx:if="{{summary.by_type.length > 0}}">
        <view class="by-type-line" wx:for="{{summary.by_type}}" wx:key="game_type_text">{{item.game_type_text}} {{item.total}} 次，正确率 {{item.avg_accuracy}}%</view>
      </view>
    </view>

    <view class="empty" wx:if="{{loaded && records.length === 0}}">还没有训练记录，去聊聊天吧</view>

    <view class="list" wx:if="{{records.length > 0}}">
      <view class="item" wx:for="{{records}}" wx:key="index">
        <view class="name">{{item.game_type_text}}</view>
        <view class="meta">{{item.difficulty_text}} · 正确率{{item.accuracy}}% · 用时{{item.duration}}秒 · {{item.date}}</view>
      </view>
    </view>

    <view class="disclaimer">本结果只用于调整练习难度，不作为任何健康判断。</view>
  </block>
</view>

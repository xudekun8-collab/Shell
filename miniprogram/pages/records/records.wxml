<view class="page pad">
  <view class="page-head">
    <view class="page-head-main">
      <view class="page-kicker">一步一步，都算数</view>
      <view class="t-hero">练习记录</view>
    </view>
    <view class="head-action" hover-class="press" bindtap="goSettings">
      <text>设置</text>
      <text class="head-action-arrow">›</text>
    </view>
  </view>

  <view class="status card" wx:if="{{loading}}">正在读…</view>

  <view class="status clickable btn-ghost" wx:if="{{load_error}}" bindtap="retry">没读到，点这里再试一次</view>

  <block wx:if="{{!loading && !load_error}}">
    <block wx:if="{{summary.total > 0}}">
      <!-- 今天：老人最想知道的就这一句，连续天数做右边的主视觉 -->
      <view class="today-card">
        <view class="today-left">
          <view class="today-label">今天</view>
          <view class="today-value" wx:if="{{summary.today_count > 0}}">练了 {{summary.today_count}} 次</view>
          <view class="today-value" wx:else>还没开始练</view>
          <view class="today-sub" wx:if="{{summary.today_count > 0}}">一共 {{summary.today_duration_text}}</view>
          <view class="today-sub" wx:else>一局也就几分钟</view>
        </view>
        <view class="today-right" wx:if="{{summary.streak_days > 0}}">
          <view class="streak-num">{{summary.streak_days}}</view>
          <view class="streak-label">天连着练</view>
        </view>
        <view class="today-right" wx:else>
          <view class="streak-num dim">从今天</view>
          <view class="streak-label">开始数</view>
        </view>
      </view>

      <view class="total-line">累计练了 {{summary.total}} 次 · 一共 {{summary.total_duration_text}}</view>

      <view class="by-type" wx:if="{{summary.by_type.length > 0}}">
        <view class="by-type-chip" wx:for="{{summary.by_type}}" wx:key="game_type_text">{{item.game_type_text}} {{item.total}} 次</view>
      </view>
    </block>

    <view class="empty card" wx:if="{{loaded && summary.total === 0}}">
      <view class="empty-title">还没有练习记录</view>
      <view class="empty-copy">先聊两句也行，想练的时候随时点下面的练习。</view>
      <view class="empty-btn btn-main" hover-class="press" bindtap="goGame">去练一次</view>
    </view>

    <!-- 筛选态：顶部一条返回，标题在右，列表不再重复组标题 -->
    <view class="filter-bar" wx:if="{{isFiltered}}">
      <view class="filter-back" hover-class="press" bindtap="onFilterAll">
        <text class="back-mark">‹</text>
        <text>全部</text>
      </view>
      <view class="filter-current">{{activeLabel}} · {{activeCount}} 次</view>
    </view>

    <!-- 按天分组：今天 / 昨天 / 3 天前 / 11-08；点标题就看这一天的记录 -->
    <view class="list-hint" wx:if="{{!isFiltered && groups.length > 1}}">点日期，只看那一天的记录</view>

    <view class="group" wx:for="{{groups}}" wx:key="label" wx:for-item="group">
      <view class="group-head" wx:if="{{group.label}}" hover-class="press" data-date="{{group.date}}" bindtap="onGroupTap">
        <view class="group-label">{{group.label}}</view>
        <view class="group-tail">
          <text class="group-count">{{group.count}} 次</text>
          <text class="group-arrow">›</text>
        </view>
      </view>
      <view class="item card" wx:for="{{group.items}}" wx:key="key" hover-class="press">
        <view class="type-mark {{item.game_type}}">{{item.type_mark}}</view>
        <view class="item-body">
          <view class="name-row">
            <view class="name">{{item.game_type_text}}</view>
            <view class="result {{item.result_tone}}">{{item.result_text}}</view>
          </view>
          <view class="meta">{{item.difficulty_text}} · 共 {{item.total_count}} 题 · {{item.duration_text}}</view>
        </view>
      </view>
    </view>

    <view class="group-empty" wx:if="{{isFiltered && groups[0].items.length === 0}}">这一天没有记录</view>

    <view class="disclaimer">本结果只用于调整练习难度，不作为任何健康判断。</view>
  </block>
</view>

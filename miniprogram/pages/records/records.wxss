.page {
  padding-top: var(--sp-4);
  padding-bottom: calc(28rpx + 112rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-head {
  margin-bottom: var(--sp-4);
}

.page-kicker {
  margin-bottom: var(--sp-1);
  font-size: var(--fs-note);
  font-weight: 600;
  color: var(--c-accent);
}

.summary {
  display: flex;
  flex-direction: column;
  margin-bottom: var(--sp-4);
  background-color: var(--c-primary);
  border-radius: var(--r-lg);
  padding: var(--sp-3) 0;
  box-shadow: 0 12rpx 30rpx rgba(23, 57, 92, 0.16);
}

.summary-row {
  display: flex;
}

.sum-item {
  flex: 1;
  min-width: 0;
  padding: 0 var(--sp-1);
  text-align: center;
  color: #ffffff;
  box-sizing: border-box;
}

.sum-item + .sum-item {
  border-left: 1rpx solid rgba(255, 255, 255, 0.2);
}

.sum-item .num {
  font-size: var(--fs-title);
  font-weight: bold;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.sum-item .label {
  margin-top: 8rpx;
  font-size: var(--fs-note);
  line-height: 1.4;
  color: #dce5f0;
}

.by-type {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
  padding: var(--sp-2) var(--sp-3) 0;
}

.by-type-chip {
  padding: 6rpx 16rpx;
  font-size: var(--fs-note);
  line-height: 1.5;
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.12);
  border-radius: var(--r-pill);
}

.status {
  padding: 120rpx 0;
  text-align: center;
  font-size: var(--fs-note);
  color: var(--c-text-weak);
}

.status.clickable {
  margin: 120rpx 0;
  padding: 0 var(--sp-3);
  font-size: var(--fs-body);
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--c-text-weak);
}

.empty-btn {
  width: 360rpx;
  min-height: 96rpx;
  margin: 0 auto var(--sp-4);
  font-size: var(--fs-body);
}

.item {
  margin-bottom: var(--sp-3);
  border-left: 6rpx solid var(--c-line);
}

.item.memory_box {
  border-left-color: var(--c-primary);
}

.item.category_sort {
  border-left-color: var(--c-accent);
}

.item.number_seq {
  border-left-color: var(--c-success);
}

.item.common_sense {
  border-left-color: #b08a3e;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.item .name {
  font-size: var(--fs-body);
  color: var(--c-primary);
}

.abandoned-badge {
  flex: none;
  padding: 4rpx 12rpx;
  font-size: var(--fs-note);
  color: var(--c-text-weak);
  background-color: var(--c-soft);
  border-radius: var(--r-sm);
}

.item .meta {
  font-size: var(--fs-note);
  line-height: 1.6;
  color: var(--c-text-weak);
  overflow-wrap: anywhere;
}

.meta-row {
  margin-top: var(--sp-1);
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--sp-2);
}

.meta-row .meta {
  flex: 1 1 auto;
  min-width: 0;
}

.item-date {
  flex: none;
  font-size: var(--fs-note);
  color: var(--c-muted);
}

.disclaimer {
  margin-top: 32rpx;
  padding: 24rpx;
  font-size: var(--fs-note);
  color: var(--c-text-weak);
  text-align: center;
}

.settings-link {
  width: 100%;
  margin-top: var(--sp-4);
  font-size: var(--fs-body);
  color: var(--c-primary);
  background-color: var(--c-brand-soft);
  border-color: transparent;
}

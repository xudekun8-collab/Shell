.page {
  padding-top: var(--sp-4);
  padding-bottom: calc(28rpx + 112rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-4);
}

.page-head-main {
  flex: 1 1 auto;
  min-width: 0;
}

/* 设置入口挪到页头右上角，不占列表底部一行按钮 */
.head-action {
  flex: none;
  min-width: 168rpx;
  min-height: 88rpx;
  padding: 0 var(--sp-3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: var(--fs-body);
  color: var(--c-primary);
  background-color: var(--c-brand-soft);
  border-radius: var(--r-pill);
  box-sizing: border-box;
}

.head-action-arrow {
  font-size: var(--fs-title);
  color: var(--c-accent);
}

.page-kicker {
  margin-bottom: var(--sp-1);
  font-size: var(--fs-note);
  font-weight: 600;
  color: var(--c-accent);
}

/* ---------- 今天 ---------- */

.today-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-3);
  padding: var(--sp-4);
  background-color: var(--c-primary);
  border-radius: var(--r-lg);
  box-shadow: 0 12rpx 30rpx rgba(23, 57, 92, 0.16);
  box-sizing: border-box;
}

.today-left {
  flex: 1 1 auto;
  min-width: 0;
}

.today-label {
  font-size: var(--fs-note);
  color: #c8d5e4;
}

.today-value {
  margin-top: 6rpx;
  font-size: var(--fs-hero);
  font-weight: 700;
  line-height: 1.3;
  color: #ffffff;
}

.today-sub {
  margin-top: 4rpx;
  font-size: var(--fs-note);
  color: #dce5f0;
}

.today-right {
  flex: none;
  min-width: 180rpx;
  padding-left: var(--sp-3);
  border-left: 1rpx solid rgba(255, 255, 255, 0.22);
  text-align: center;
  box-sizing: border-box;
}

.streak-num {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.15;
  color: #ffd9a8;
}

.streak-num.dim {
  font-size: var(--fs-body);
  color: #c8d5e4;
}

.streak-label {
  margin-top: 4rpx;
  font-size: var(--fs-note);
  color: #dce5f0;
}

/* ---------- 累计与分题型 ---------- */

.total-line {
  margin: var(--sp-3) 0 var(--sp-2);
  font-size: var(--fs-note);
  color: var(--c-text-weak);
}

.by-type {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-1);
  margin-bottom: var(--sp-3);
}

.by-type-chip {
  padding: 8rpx 20rpx;
  font-size: var(--fs-note);
  line-height: 1.5;
  color: var(--c-primary);
  background-color: var(--c-brand-soft);
  border-radius: var(--r-pill);
}

/* ---------- 状态 ---------- */

.status {
  padding: 60rpx 0;
  text-align: center;
  font-size: var(--fs-note);
  color: var(--c-text-weak);
}

.status.clickable {
  margin: 60rpx 0;
  padding: 32rpx var(--sp-3);
  font-size: var(--fs-body);
}

/* ---------- 空态 ---------- */

.empty {
  margin-top: var(--sp-3);
  padding: 56rpx var(--sp-3) 40rpx;
  text-align: center;
}

.empty-title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--c-text);
}

.empty-copy {
  margin: var(--sp-2) auto var(--sp-3);
  max-width: 520rpx;
  font-size: var(--fs-note);
  line-height: 1.6;
  color: var(--c-text-weak);
}

.empty-btn {
  width: 360rpx;
  min-height: 96rpx;
  margin: 0 auto;
  font-size: var(--fs-body);
}

/* ---------- 日期筛选（点日期标题弹出面板） ---------- */

.list-hint {
  margin: var(--sp-2) 0 0;
  font-size: var(--fs-note);
  color: var(--c-text-weak);
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background-color: rgba(28, 24, 20, 0.45);
}

.sheet {
  width: 100%;
  padding: var(--sp-3) var(--sp-4) calc(var(--sp-3) + env(safe-area-inset-bottom));
  background-color: var(--c-surface);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  box-sizing: border-box;
}

.sheet-title {
  padding: var(--sp-1) 0 var(--sp-2);
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--c-text);
  text-align: center;
}

.sheet-scroll {
  max-height: 52vh;
}

.sheet-item {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-height: 96rpx;
  padding: 0 var(--sp-2);
  border-bottom: 1rpx solid var(--c-line);
  box-sizing: border-box;
}

.sheet-item.active .sheet-label {
  color: var(--c-primary);
  font-weight: 700;
}

.sheet-label {
  flex: 1 1 auto;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--c-text);
}

.sheet-count {
  flex: none;
  font-size: var(--fs-note);
  color: var(--c-text-weak);
}

.sheet-check {
  flex: none;
  width: 40rpx;
  font-size: var(--fs-body);
  color: var(--c-success);
  text-align: center;
}

.sheet-cancel {
  margin-top: var(--sp-3);
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  color: var(--c-text-weak);
  background-color: var(--c-brand-soft);
  border-radius: var(--r-pill);
}

.group-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: var(--fs-note);
  color: var(--c-text-weak);
}

/* ---------- 按天分组 ---------- */

.group {
  margin-bottom: var(--sp-1);
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-1);
  padding: var(--sp-2) var(--sp-1);
  min-height: 88rpx;
  border-radius: var(--r-sm);
  box-sizing: border-box;
}

.group-label {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--c-text);
}

.group-tail {
  flex: none;
  display: flex;
  align-items: center;
  gap: var(--sp-1);
}

.group-count {
  font-size: var(--fs-note);
  color: var(--c-muted);
}

.group-caret {
  font-size: var(--fs-note);
  color: var(--c-accent);
}

/* ---------- 单条记录 ---------- */

.item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: var(--sp-2);
}

.type-mark {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 700;
  color: #ffffff;
  border-radius: 20rpx;
  background-color: var(--c-primary);
}

.type-mark.category_sort {
  background-color: var(--c-accent);
}

.type-mark.number_seq {
  background-color: var(--c-success);
}

.type-mark.common_sense {
  background-color: #b08a3e;
}

.item-body {
  flex: 1 1 auto;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--sp-2);
}

.name {
  flex: 1 1 auto;
  min-width: 0;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-text);
}

.result {
  flex: none;
  font-size: var(--fs-body);
}

.result.good {
  color: var(--c-success);
  font-weight: 600;
}

.result.muted {
  color: var(--c-text-weak);
}

.meta {
  margin-top: 6rpx;
  font-size: var(--fs-note);
  line-height: 1.5;
  color: var(--c-text-weak);
}

/* ---------- 页脚 ---------- */

.disclaimer {
  margin-top: var(--sp-4);
  padding: 0 var(--sp-3);
  font-size: var(--fs-note);
  line-height: 1.6;
  color: var(--c-text-weak);
  text-align: center;
}

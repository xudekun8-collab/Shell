.page {
  padding: 28rpx;
}

.summary {
  display: flex;
  margin-bottom: 24rpx;
  background-color: var(--c-primary);
  border-radius: var(--r-card);
  padding: 24rpx 0;
}

.sum-item {
  flex: 1;
  text-align: center;
  color: #ffffff;
}

.sum-item .num {
  font-size: 44rpx;
  font-weight: bold;
}

.sum-item .label {
  margin-top: 8rpx;
  font-size: 32rpx;
  color: #dce5f0;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--c-text-weak);
}

.item {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background-color: var(--c-surface);
  border-radius: var(--r-card);
}

.item .name {
  font-size: 36rpx;
  color: var(--c-primary);
}

.item .meta {
  margin-top: 12rpx;
  font-size: 32rpx;
  color: var(--c-text-weak);
}

.disclaimer {
  margin-top: 32rpx;
  padding: 24rpx;
  font-size: 32rpx;
  color: var(--c-text-weak);
  text-align: center;
}

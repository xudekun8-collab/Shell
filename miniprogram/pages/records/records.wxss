.page {
  padding: 24rpx;
}

.summary {
  display: flex;
  margin-bottom: 24rpx;
  background-color: #1f3a5f;
  border-radius: 12rpx;
  padding: 24rpx 0;
}

.sum-item {
  flex: 1;
  text-align: center;
  color: #ffffff;
}

.sum-item .num {
  font-size: 44rpx;
  font-weight: bold;
}

.sum-item .label {
  margin-top: 8rpx;
  font-size: 32rpx;
  color: #dce5f0;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #999999;
}

.item {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
}

.item .name {
  font-size: 36rpx;
  color: #1f3a5f;
}

.item .meta {
  margin-top: 12rpx;
  font-size: 32rpx;
  color: #666666;
}

.disclaimer {
  margin-top: 32rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #999999;
  text-align: center;
}

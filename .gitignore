# Python 虚拟环境与缓存
backend/.venv/
__pycache__/
*.py[cod]

# 密钥与环境变量：backend/.env 里有真实 DeepSeek key，严禁入库
backend/.env
*.env.local

# 自签证书私钥（证书公钥可提交，私钥不可）
deploy/certs/key.pem

# compose 层本地环境变量（.env.example 入库，真实 .env 不入库）
deploy/.env

# 本地数据库与日志
*.db
*.sqlite3
backend/*.log
backend/_uv_*.log

# 临时输出文件
backend/_*.txt
backend/eval_out.txt
backend/data/*.legacy_backup.json

# 编辑器与系统文件
.vscode/
.idea/
Thumbs.db

# 测试缓存
.pytest_cache/

# 过程文档：需求记录、提示词、临时笔记只留在本地，不入库也不推远程
.requirements/
skill.txt
*提示词*.md
Codex*.md

